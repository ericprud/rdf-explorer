{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@modular-rdf/api-graph-source":  ["../api-graph-source/src/api-graph-source.ts"],
      "@modular-rdf/api-graph-handler": ["../api-graph-handler/src/api-graph-handler.ts"],
      "@modular-rdf/util-rdf":         ["../util-rdf/src/util-rdf.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
